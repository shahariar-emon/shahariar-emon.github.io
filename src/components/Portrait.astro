---
import { Image } from 'astro:assets';
import portrait from '../assets/shahariar-emon.jpg';
const {small=false}=Astro.props;
---
<Image src={portrait} alt="Shahariar Emon" class:list={['profile-portrait',{'profile-portrait-small':small}]} widths={small?[80,160]:[360,720,1000]} sizes={small?'56px':'(max-width: 800px) calc(100vw - 96px), 290px'} format="webp" quality={85} loading={small?'eager':'lazy'} />
