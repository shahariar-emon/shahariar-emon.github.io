---
import { sitePath } from "../utils/paths";
const {p,full=false}=Astro.props;
---
<article class="publication" data-publication data-themes={p.themes.join(' ')} data-search={`${p.title} ${p.authors} ${p.journal} ${p.year}`.toLowerCase()}><div class="pub-year">{p.year}<span>{p.type}</span></div><div class="pub-body"><p class="eyebrow">{p.journal} <span>· {p.details}</span></p><h3><a href={`https://doi.org/${p.doi}`} target="_blank" rel="noreferrer">{p.title}<span aria-hidden="true"> ↗</span></a></h3>{full&&<p class="authors">{p.authors}</p>}<p>{p.summary}</p><div class="text-links">{p.project&&<a href={sitePath(p.project)}>Explore the research →</a>}<a href={`https://doi.org/${p.doi}`} target="_blank" rel="noreferrer">DOI ↗</a>{full&&<details class="citation"><summary>BibTeX</summary><pre>{p.bibtex}</pre><button data-copy={p.bibtex}>Copy citation</button><span class="copy-status" aria-live="polite"></span></details>}</div></div></article>
