---
import { sitePath } from "../utils/paths";
import '../styles/global.css';
import { profile } from '../data/profile';
const { title = 'Molecular simulation & membrane biophysics', description = 'Shahariar Emon studies membrane biophysics and protein–small-molecule interactions through molecular simulation.', active = '' } = Astro.props;
const nav = [['Research','/research/'],['Publications','/publications/'],['Software','/software/'],['About','/about/'],['Beyond research','/hobbies/']];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#F2F2F5"/><title>{title} · Shahariar Emon</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml"/><meta property="og:type" content="website"/><meta property="og:title" content={`${title} · Shahariar Emon`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(sitePath('/images/membrane-detail.webp'),Astro.site)}/><meta name="twitter:card" content="summary_large_image"/></head>
<body id="top"><a class="skip" href="#main">Skip to content</a><header class="site-header"><div class="container header-inner"><a class="brand" href={sitePath("/")} aria-label="Shahariar Emon home"><span class="monogram">se<span>.</span></span><span>Shahariar Emon<span class="brand-sub">Computational biophysics</span></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu <span aria-hidden="true">☰</span></button><nav id="main-nav" aria-label="Main navigation">{nav.map(([label,href])=><a href={sitePath(href)} aria-current={active === label ? 'page' : undefined}>{label}</a>)}<a class="nav-contact" href={sitePath("/about/#contact")}>Get in touch <span aria-hidden="true">↗</span></a></nav></div></header>
<main id="main"><slot/></main>
<footer><div class="container"><div class="footer-top"><div><p class="eyebrow">Connect</p><h2>Let’s talk science.</h2><a class="email-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a></div><div class="footer-links">{profile.profiles.filter(p=>['Google Scholar','ORCID','ResearchGate','GitHub'].includes(p.label)).map(p=><a href={p.url} target="_blank" rel="noreferrer">{p.label} ↗</a>)}<a href={sitePath("/about/#contact")}>All contact details →</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Shahariar Emon</span><span>Molecular simulation. Biological questions.</span><a href="#top" data-top>Back to top ↑</a></div></div></footer>
<dialog id="figure-dialog" aria-label="Enlarged research figure"><div class="dialog-toolbar"><span>Research figure</span><form method="dialog"><button aria-label="Close enlarged figure">Close ×</button></form></div><img id="dialog-image" alt=""/><p id="dialog-caption"></p><a id="fullsize-link" class="text-link" href={sitePath("/")} target="_blank" rel="noreferrer">Open full-size image ↗</a></dialog>
<script>
 const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector('#main-nav');
 toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open);});
 document.addEventListener('keydown',(e)=>{if(e.key==='Escape'){toggle?.setAttribute('aria-expanded','false');nav?.classList.remove('open');}});
 document.querySelector('[data-top]')?.addEventListener('click',e=>{e.preventDefault();window.scrollTo({top:0,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});});
 const dialog=document.querySelector<HTMLDialogElement>('#figure-dialog');
 document.querySelectorAll<HTMLAnchorElement>('[data-figure]').forEach(link=>link.addEventListener('click',e=>{if(!dialog)return;e.preventDefault();const img=dialog.querySelector<HTMLImageElement>('img')!;img.src=link.href;(dialog.querySelector('#fullsize-link') as HTMLAnchorElement).href=link.href;img.alt=link.dataset.alt||'';dialog.querySelector('#dialog-caption')!.textContent=link.dataset.caption||'';dialog.showModal();}));
 dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close();});
</script></body></html>
