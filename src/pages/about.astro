---
import { sitePath } from '../utils/paths';
import Base from '../layouts/Base.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import { photos } from '../data/photos';
import { profile } from '../data/profile';
const awardPhotos = photos.conferences.filter(p => ['best-paper-award', 'best-poster-award'].includes(p.slug));
---
<Base title="About & contact" active="About" description="Shahariar Emon's affiliations, education, Sakura Science exchange and academic highlights.">
  <section class="container page-intro about-intro"><p class="eyebrow">About</p><h1>Background &amp;<br/><span>experience.</span></h1></section>
  <section class="container brief-background" id="experience" aria-label="Affiliations and education">
    <dl class="background-list">
      <div><dt>Current affiliation<span>Nov 2025 — present</span></dt><dd><h2>Research Manager</h2><p>HEAT Project · Department of Biotechnology and Genetic Engineering<br/>Islamic University, Bangladesh</p><p class="affiliation-summary">I lead the computational work on a project studying how small molecules may influence autophagy in cancer.</p></dd></div>
      <div><dt>Previous experience<span>May 2024 — Oct 2025</span></dt><dd><h2>Research Assistant</h2><p>K. Alam Research Laboratory · Department of Physics<br/>University of Barishal, Bangladesh</p><p class="affiliation-summary">I studied electroporation and molecular transport using molecular dynamics and diffusion modeling, and mentored junior researchers in simulation and data analysis.</p></dd></div>
      <div><dt>Education<span>Completed Jul 2023</span></dt><dd><h2>BSc in Physics</h2><p>University of Barishal, Bangladesh</p></dd></div>
    </dl>
  </section>
  <section class="container academic-section" aria-labelledby="practice-title"><div class="academic-section-heading"><p class="eyebrow">Research life</p><h2 id="practice-title">Research in practice.</h2></div><PhotoGallery items={[photos.mbl[0], photos.karl[0]]} label="MBL and KARL research experience" /><a class="text-link album-link" href={sitePath('/gallery/#mbl')}>MBL research &amp; training →</a> <a class="text-link album-link" href={sitePath('/gallery/#karl')}>KARL collaboration &amp; team →</a></section>
  <section class="container academic-section" id="sakura" aria-labelledby="sakura-title"><div class="academic-section-heading"><p class="eyebrow">Sakura Science</p><h2 id="sakura-title">Scientific exchange in Japan.</h2><p class="photo-gallery-note">Kogakuin University · 25 February–3 March 2025</p><p class="photo-gallery-note">I presented my research, attended computational chemistry sessions, and took part in a research exchange at Tohoku University.</p></div><PhotoGallery items={photos.sakura.slice(0, 2)} label="Sakura Science exchange photographs" /><a class="text-link album-link" href={sitePath('/gallery/#sakura')}>Explore the exchange album →</a></section>
  <section class="container academic-section" id="recognition" aria-labelledby="highlights-title"><div class="academic-section-heading"><p class="eyebrow">Academic highlights</p><h2 id="highlights-title">Conferences &amp; recognition.</h2></div><PhotoGallery items={awardPhotos} label="Conference awards" /><div class="theme-links album-link"><a class="text-link" href={sitePath('/gallery/#awards')}>Awards &amp; conference photographs →</a><a class="text-link" id="presentations" href={sitePath('/publications/#presentations')}>Selected conference presentations →</a></div></section>
  <section class="container contact-section" id="contact">
    <div><p class="eyebrow">Contact</p><h2>Start a conversation.</h2><p>For research discussions, collaborations, and professional inquiries.</p></div>
    <div class="contact-details"><a href={`mailto:${profile.email}`}>{profile.email} ↗</a><a href={`mailto:${profile.secondaryEmail}`}>{profile.secondaryEmail} ↗</a><a href={`tel:${profile.phoneHref}`}>{profile.phone}</a><div class="profile-links">{profile.profiles.map(p=><a href={p.url} target="_blank" rel="noreferrer">{p.label} ↗</a>)}</div></div>
  </section>
</Base>
