---
import { sitePath } from "../utils/paths";
import Base from '../layouts/Base.astro';import Portrait from '../components/Portrait.astro';import {profile} from '../data/profile';
---
<Base title="About & contact" active="About"><section class="container page-intro"><p class="eyebrow">About me</p><h1>Physics meets biology.<br/><span>Curiosity connects them.</span></h1></section><section class="container about-grid"><div class="identity-block"><Portrait /><h2>{profile.name}</h2><p>{profile.title}</p><p>{profile.department}<br/>{profile.institution}</p></div><div class="about-copy"><h2>Understanding biological systems through computation.</h2><p>My research interests focus on molecular simulation, membrane biophysics, and protein–small-molecule interactions. I use computational approaches to investigate how molecular behavior connects to biological function.</p><p>My published work includes molecular dynamics studies of electroporation and the development of semdock, a workflow for virtual screening from raw chemical datasets.</p><p>I currently lead the computational biology arm of a cancer autophagy project as a Research Manager at Islamic University, Bangladesh. My work combines virtual screening and molecular dynamics with experimental studies of small-molecule–membrane interactions.</p><div class="interest-list"><span>Membrane biophysics</span><span>Molecular simulation</span><span>Protein–ligand interactions</span><span>Scientific software</span></div><a class="text-link" href={sitePath("/publications/")}>Explore publications →</a><p class="beyond-link">Outside research, I enjoy music and photography. <a class="text-link" href={sitePath("/hobbies/")}>Beyond the research →</a></p></div></section>
<section class="container academic-section" aria-labelledby="experience-heading">
  <div class="section-heading"><div><p class="eyebrow">Academic background</p><h2 id="experience-heading">Experience & education.</h2></div></div>
  <div class="academic-grid">
    <article class="academic-card"><p class="eyebrow">November 2025–present</p><h3>Research Manager</h3><p>Department of Biotechnology and Genetic Engineering, Islamic University, Bangladesh</p><p>Leading computational biology for the HEAT sub-project “Discovery of Drug Against Cancer through the Regulation of Autophagy,” led by Dr. Alam Md. Jahangir. My work includes high-throughput screening against p62, molecular dynamics of protein–small-molecule interactions, and GUV preparation for experimental membrane studies.</p></article>
    <article class="academic-card"><p class="eyebrow">May 2024–October 2025</p><h3>Research Assistant</h3><p>K. Alam Research Laboratory, Department of Physics, University of Barishal · Dr. Md. Khorshed Alam</p><p>Used all-atom and coarse-grained molecular dynamics to study electroporation and small-molecule–membrane interactions, and developed PDE models in MATLAB for molecular transport. Mentored more than five junior researchers in simulation, analysis, and manuscript preparation.</p></article>
    <article class="academic-card"><p class="eyebrow">July 2023</p><h3>BSc in Physics</h3><p>University of Barishal, Bangladesh</p><p>A physics foundation for investigating biological interactions through molecular simulation and quantitative modeling.</p></article>
    <article class="academic-card"><p class="eyebrow">25 February–3 March 2025</p><h3>Sakura Science Exchange Program</h3><p>Kogakuin University, Japan</p><p>Participated in laboratory tours, computational chemistry lectures, and research discussions, and presented research findings to faculty and peers.</p></article>
  </div>
</section>
<section class="container academic-section" aria-labelledby="awards-heading">
  <p class="eyebrow">Recognition</p><h2 id="awards-heading">Awards.</h2>
  <ul class="academic-list">
    <li><span class="academic-date">2025</span><div><h3>Best Poster Presenter Award</h3><p>Bridging the Theoretical and Experimental Biophysicists in Bangladesh · Biophysical Society Networking Event, University of Barishal</p></div></li>
    <li><span class="academic-date">2024</span><div><h3>Best Paper Award</h3><p>National Conference on Physics for 21st Century · Physics Discipline, Khulna University</p></div></li>
  </ul>
</section>
<section class="container academic-section" aria-labelledby="presentations-heading">
  <p class="eyebrow">Scientific communication</p><h2 id="presentations-heading">Conference presentations.</h2>
  <ul class="academic-list">
    <li><span class="academic-date">October 2025 · Oral</span><div><h3>Molecular Dynamics of the Hydrophobic–Hydrophilic Transition During Electroporation</h3><p>12th International Conference on Physics in Medicine-2025 · University of Dhaka</p></div></li>
    <li><span class="academic-date">April 2025 · Poster</span><div><h3>Investigating Pore Stabilization Dynamics During Electroporation via MD Simulations</h3><p>Bridging the Theoretical and Experimental Biophysicists in Bangladesh · University of Barishal</p></div></li>
    <li><span class="academic-date">February 2025 · Oral</span><div><h3>Unraveling Amyloid Beta Clearance Mechanisms by ABCG2 Efflux pump in Alzheimer’s Disease using MD</h3><p>National Conference on Physics-2025 · University of Rajshahi</p></div></li>
    <li><span class="academic-date">May 2024 · Oral</span><div><h3>Simulation and Quantitative Analysis of Biomacromolecules Transport through Nanopores in an Electroporated GUV</h3><p>National Conference on Physics for 21st Century · Khulna University</p></div></li>
  </ul>
</section>
<section class="container academic-section" aria-labelledby="service-heading">
  <p class="eyebrow">Service & community</p><h2 id="service-heading">Sharing methods and ideas.</h2>
  <div class="academic-grid">
    <article class="academic-card"><h3>Mentoring & peer review</h3><p>Mentored junior researchers in molecular dynamics, data analysis, and scientific writing. Reviewed a manuscript for PLOS ONE in November 2025.</p></article>
    <article class="academic-card"><h3>Science outreach</h3><p>Led school awareness campaigns using interactive simulations to demonstrate environmental impacts. Participated in the NASA International Space Apps Challenge in October 2024 and served as Publicity Secretary of the Barishal University Physics Student Welfare Association in 2018–2019.</p></article>
  </div>
</section>
<section class="container contact-section" id="contact"><div><p class="eyebrow">Contact</p><h2>Start a conversation.</h2><p>For research discussions, collaborations, and professional inquiries.</p></div><div class="contact-details"><a href={`mailto:${profile.email}`}>{profile.email} ↗</a><a href={`mailto:${profile.secondaryEmail}`}>{profile.secondaryEmail} ↗</a><a href={`tel:${profile.phoneHref}`}>{profile.phone}</a><div class="profile-links">{profile.profiles.map(p=><a href={p.url} target="_blank" rel="noreferrer">{p.label} ↗</a>)}</div></div></section></Base>
