---
import { sitePath } from "../utils/paths";
import Base from '../layouts/Base.astro';import Portrait from '../components/Portrait.astro';import {profile} from '../data/profile';
---
<Base title="About & contact" active="About"><section class="container page-intro"><p class="eyebrow">About me</p><h1>Physics meets biology.<br/><span>Curiosity connects them.</span></h1></section><section class="container about-grid"><div class="identity-block"><Portrait /><h2>{profile.name}</h2><p>{profile.title}</p><p>{profile.department}<br/>{profile.institution}</p></div><div class="about-copy"><h2>Understanding biological systems through computation.</h2><p>My research interests focus on molecular simulation, membrane biophysics, and protein–small-molecule interactions. I use computational approaches to investigate how molecular behavior connects to biological function.</p><p>My published work includes molecular dynamics studies of electroporation and the development of semdock, a workflow for virtual screening from raw chemical datasets.</p><p>I currently work as a Research Manager in the Department of Biotechnology and Genetic Engineering at Islamic University, Bangladesh.</p><div class="interest-list"><span>Membrane biophysics</span><span>Molecular simulation</span><span>Protein–ligand interactions</span><span>Scientific software</span></div><a class="text-link" href={sitePath("/publications/")}>Explore publications →</a><p class="beyond-link">Outside research, I enjoy music and photography. <a class="text-link" href={sitePath("/hobbies/")}>Beyond the research →</a></p></div></section><section class="container contact-section" id="contact"><div><p class="eyebrow">Contact</p><h2>Start a conversation.</h2><p>For research discussions, collaborations, and professional inquiries.</p></div><div class="contact-details"><a href={`mailto:${profile.email}`}>{profile.email} ↗</a><a href={`mailto:${profile.secondaryEmail}`}>{profile.secondaryEmail} ↗</a><a href={`tel:${profile.phoneHref}`}>{profile.phone}</a><div class="profile-links">{profile.profiles.map(p=><a href={p.url} target="_blank" rel="noreferrer">{p.label} ↗</a>)}</div></div></section></Base>
