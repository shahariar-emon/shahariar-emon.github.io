---
import { sitePath } from "../utils/paths";
import Base from '../layouts/Base.astro';import Portrait from '../components/Portrait.astro';import Publication from '../components/Publication.astro';import {publications} from '../data/publications';import {profile} from '../data/profile';
---
<Base><section class="container hero"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> Molecular simulation · Biophysics</p><h1>Exploring life at the <span>molecular scale.</span></h1><p class="hero-intro">I’m Shahariar Emon. I explore how membranes behave and molecules interact, using simulation to connect molecular detail with biological function.</p><div class="actions"><a class="button" href={sitePath("/research/")}>Explore my research <span>↗</span></a><a class="text-link" href={sitePath("/publications/")}>Selected publications →</a></div><div class="hero-affiliation"><a href={sitePath("/about/")} aria-label="About Shahariar Emon"><Portrait small /></a><strong>{profile.title}</strong><span class="affiliation-details"><span class="affiliation-project">{profile.project}</span>{profile.department}<br/>{profile.institution}</span></div></div><div class="hero-art"><div class="image-heading"><span>01 / Inside the membrane</span><span>Molecular detail</span></div><a href={sitePath("/research/electroporation/")} class="hero-image"><img src={sitePath("/images/membrane-detail.webp")} alt="Molecular detail of a membrane pore, cropped from Figure 1 of the electroporation study" width="1440" height="960" fetchpriority="high"/><span class="image-arrow" aria-hidden="true">↗</span></a><div class="image-foot"><span>A closer look at membrane permeabilization.</span><a href={sitePath("/research/electroporation/#figures")}>Figure 1 · detail ↗</a></div><div class="visual-note"><span class="large-number">10<sup>−9</sup> m</span><span>Small scales.<br/>Fundamental questions.</span></div></div></section>
<div class="research-strip"><div class="container"><span>Research focus</span><a href={sitePath("/research/electroporation/")}>Membrane biophysics</a><span class="strip-plus">+</span><a href={sitePath("/research/semdock/")}>Protein–small-molecule interactions</a><span class="strip-plus">+</span><a href={sitePath("/research/")}>Molecular simulation</a></div></div>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">01 / Selected research</p><h2>Biological questions.<br/><span>Molecular perspectives.</span></h2></div><a class="text-link" href={sitePath("/research/")}>All research →</a></div><div class="project-grid"><a class="project-card" href={sitePath("/research/electroporation/")}><div class="project-image membrane"><img src={sitePath("/images/electroporation-figure-4.webp")} alt="Top and side views of a membrane pore over time" loading="lazy"/><span class="card-arrow">↗</span></div><div class="card-meta"><span>Membrane biophysics</span><span>2025</span></div><h3>Controlling the lifetime<br/>of a membrane pore.</h3><p>Exploring how electric-pulse timing shapes electroporation and molecular transport.</p><span class="text-link">Explore the study →</span></a><a class="project-card" href={sitePath("/research/semdock/")}><div class="project-image docking"><img src={sitePath("/images/semdock-abstract.webp")} alt="The semdock workflow: ligand preparation, receptor preparation, docking and filtering" loading="lazy"/><span class="card-arrow">↗</span></div><div class="card-meta"><span>Protein–ligand interactions</span><span>2026</span></div><h3>From chemical datasets<br/>to molecular candidates.</h3><p>Connecting ligand preparation and virtual screening through the semdock workflow.</p><span class="text-link">Explore the workflow →</span></a></div></section>
<section class="software-band"><div class="container software-inner"><div><p class="eyebrow">02 / Research software</p><h2>Meet <span class="software-name">semdock.</span></h2><p>A practical workflow for exploring protein–small-molecule interactions, from raw chemical data to filtered docking results.</p><a class="button light" href={sitePath("/software/")}>Explore the software ↗</a></div><div class="pipeline" aria-label="semdock workflow"><div><span>01</span><strong>Prepare</strong><small>SDF · SMILES · CSV</small></div><div><span>02</span><strong>Dock</strong><small>CPU-parallel screening</small></div><div><span>03</span><strong>Filter</strong><small>Prioritize candidates</small></div><a href="https://github.com/elrando/semdock" target="_blank" rel="noreferrer">View source on GitHub ↗</a></div></div></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">03 / Selected publications</p><h2>Methods, findings,<br/><span>and the work behind them.</span></h2></div><a class="text-link" href={sitePath("/publications/")}>Publication details →</a></div>{publications.filter(p=>p.featured).map(p=><Publication p={p}/>)}</section>
<section class="container about-teaser"><p class="eyebrow">A little about me</p><div><h2>At the intersection of<br/>physics and biology.</h2><p>My research interests center on molecular simulation, membrane biophysics, and protein–small-molecule interactions. With a BSc in Physics from the University of Barishal, I now lead computational biology for a cancer autophagy project at Islamic University, Bangladesh. My experience also includes mentoring junior researchers and a Sakura Science exchange at Kogakuin University, Japan.</p><a class="text-link" href={sitePath("/about/#experience")}>Academic background &amp; affiliations →</a><br/><a class="text-link" href={sitePath("/about/#presentations")}>Conference presentations →</a></div></section></Base>
