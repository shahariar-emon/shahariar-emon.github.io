---
import { sitePath } from '../utils/paths';
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import ScientificFigure from '../components/ScientificFigure.astro';
const destinations = [
  { title: 'Research', description: 'The questions behind my work on membranes, transport and molecular interactions.', href: '/research/' },
  { title: 'Publications', description: 'Published studies, protocols and selected conference presentations.', href: '/publications/' },
  { title: 'Software', description: 'Tools for molecular screening and quantitative transport modeling.', href: '/software/' },
  { title: 'About', description: 'My academic background, research experience and scientific exchange.', href: '/about/' },
  { title: 'Beyond research', description: 'Music, photography and moments beyond the laboratory.', href: '/hobbies/' },
];
---
<Base title="Computational biophysics" description="Shahariar Emon explores membrane permeabilization, molecular transport and protein–small-molecule interactions through computational biophysics.">
  <section class="container welcome">
    <div class="welcome-copy"><div class="welcome-identity"><Portrait small /><p class="eyebrow">Computational biophysics</p></div><h1>Shahariar Emon.</h1>
      <p class="welcome-intro">I study how membranes become permeable, how molecules cross them, and how small molecules influence proteins.</p>
      <p class="welcome-role">Research Manager · Islamic University, Bangladesh</p>
      <p class="welcome-motto">Exploring life at the<br/><span>molecular scale.</span></p>
      <a class="text-link" href={sitePath('/research/')}>Discover my research →</a>
    </div>
    <ScientificFigure id="membrane-water-channel" eager class="welcome-science" />
  </section>
  <section class="container discover" aria-labelledby="discover-title">
    <div class="discover-heading"><p class="eyebrow">Explore</p><h2 id="discover-title">Follow your curiosity.</h2></div>
    <div class="destination-grid">{destinations.map((item, i) => <a class="destination" href={sitePath(item.href)}><span class="destination-number">0{i + 1}</span><div><h3>{item.title} <span aria-hidden="true">↗</span></h3><p>{item.description}</p></div></a>)}</div>
  </section>
</Base>
