---
import Base from '../../layouts/Base.astro';
import ScientificFigure from '../../components/ScientificFigure.astro';
import { sitePath } from '../../utils/paths';
import { publications } from '../../data/publications';

// Reuse the bibliography without changing the comprehensive Publications page.
const publicationGroups = [
  { id: 'protein-publications', title: 'Protein–Small-Molecule Interactions', themes: ['protein-interactions'] },
  { id: 'membrane-publications', title: 'Membrane Biophysics and Permeabilization', themes: ['permeabilization', 'transport'] },
].map(group => ({
  ...group,
  papers: publications
    .filter(paper => paper.themes.some(theme => group.themes.includes(theme)))
    .sort((a, b) => b.year - a.year),
}));
---
<Base title="Research" active="Research" description="Research on protein–small-molecule interactions and membrane biophysics using molecular dynamics simulations, quantitative modeling, machine learning, and structure-based computational methods.">
  <div class="container research-overview">
    <header class="research-introduction">
      <h1>Research</h1>
      <p>My research focuses on understanding how molecular interactions and structural changes influence the behavior of biological membranes and proteins. I use molecular dynamics simulations, quantitative modeling, machine learning, and structure-based computational methods to investigate the molecular mechanisms underlying these processes.</p>
    </header>

    <section class="research-section" id="protein-interactions" aria-labelledby="protein-interactions-title">
      <h2 id="protein-interactions-title">Protein–Small-Molecule Interactions</h2>
      <p>I investigate the molecular mechanisms of protein–small-molecule interactions, with an emphasis on how ligand binding influences protein structure, dynamics, and function.</p>
      <div class="representative-figure"><ScientificFigure id="protein-small-molecule" /></div>
      <p>My current research focuses on proteins involved in autophagy regulation, particularly p62/SQSTM1 and LC3. Using structure-based virtual screening and molecular dynamics simulations, I investigate ligand recognition by different domains of p62, including PB1, ZZ, and UBA. I am particularly interested in the dynamics of PB1-domain association and how small-molecule binding may influence protein–protein interactions.</p>
      <p>I am also investigating the molecular mechanism of PBITE-1 binding to the Pointed (PNT) domain of the oncogenic transcription factor ERG, focusing on the molecular interactions and conformational dynamics underlying ligand recognition.</p>
      <p>To support these investigations, I develop and apply computational workflows for large-scale molecular screening. My work on semdock, a flexible virtual-screening workflow, facilitates chemical library preparation, parallel molecular docking, and candidate prioritization. These methods support the identification of promising protein-binding compounds for further investigation through molecular simulations and experimental studies.</p>
      <p class="project-links">Related project: <a href={sitePath('/research/semdock/')}>semdock virtual-screening workflow</a>.</p>
    </section>

    <section class="research-section" id="permeabilization" aria-labelledby="permeabilization-title">
      <h2 id="permeabilization-title">Membrane Biophysics and Permeabilization</h2>
      <p>I investigate the molecular mechanisms governing lipid membrane stability, pore formation, and permeability. My current research focuses on understanding how membrane lipid composition influences electroporation. By combining molecular dynamics simulations with machine-learning approaches, I examine the roles of different lipid species in facilitating or inhibiting pore formation and investigate the molecular interactions responsible for these effects.</p>
      <div class="representative-figure"><ScientificFigure id="membrane-water-channel" /></div>
      <p>I also study how small molecules interact with lipid membranes and influence their permeability. Using all-atom molecular dynamics simulations and free-energy calculations, I investigate how these interactions affect membrane organization, hydration, and the energetics of pore formation.</p>
      <p id="transport">My previous research on electroporation and molecular transport provides a foundation for understanding how membrane pores form, evolve, and facilitate molecular transport across lipid bilayers.</p>
      <p class="project-links">Related projects: <a href={sitePath('/research/electroporation/')}>Electroporation and pulse modulation</a>; <a href={sitePath('/research/molecular-transport/')}>Molecular transport through membrane pores</a>.</p>
    </section>

    <section class="research-section selected-publications" id="selected-publications" aria-labelledby="selected-publications-title">
      <h2 id="selected-publications-title">Selected Publications</h2>
      {publicationGroups.map(group => (
        <section class="publication-group" aria-labelledby={group.id}>
          <h3 id={group.id}>{group.title}</h3>
          <ul class="bibliography" role="list">
            {group.papers.map(paper => (
              <li>
                <p>
                  {paper.authors.split(', ').map((author, index) => <>{index > 0 && ', '}{author === 'Shahariar Emon' ? <strong>{author}</strong> : author}</>)}.
                  {' '}({paper.year}). {paper.title}. <em>{paper.journal}</em>, {paper.details}.
                  {' '}<a href={`https://doi.org/${paper.doi}`}>doi:{paper.doi}</a>
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p class="all-publications"><a href={sitePath('/publications/')}>View all publications, including collaborative works</a>.</p>
    </section>
  </div>
</Base>

<style>
  .research-overview {
    max-width: 860px;
    padding-block: 64px 80px;
  }
  .representative-figure { max-width: 580px; margin: 28px auto; }
  .research-introduction { padding-bottom: 40px; }
  h1 { font-size: clamp(40px, 5vw, 56px); margin-bottom: 28px; }
  h2 { font-size: clamp(27px, 3vw, 34px); line-height: 1.2; margin-bottom: 24px; }
  h3 { font-size: clamp(21px, 2.3vw, 25px); line-height: 1.3; margin-bottom: 20px; }
  p { font-size: 16px; line-height: 1.8; }
  p + p { margin-top: 18px; }
  a { text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  a:hover { text-decoration-thickness: 2px; }
  .research-section { padding-block: 40px; border-top: 1px solid var(--line); }
  .project-links { font-size: 14px; margin-top: 24px; }
  .publication-group { margin-top: 30px; }
  .publication-group + .publication-group { margin-top: 36px; }
  .bibliography { list-style: none; margin: 0; padding: 0; }
  .bibliography li + li { margin-top: 24px; }
  .bibliography p { font-size: 14px; line-height: 1.75; }
  .all-publications { margin-top: 32px; font-size: 14px; }
  .selected-publications { padding-bottom: 0; }
  @media (max-width: 650px) {
    .research-overview { padding-block: 40px 56px; }
    .research-introduction { padding-bottom: 32px; }
    .research-section { padding-top: 32px; }
  }
</style>
