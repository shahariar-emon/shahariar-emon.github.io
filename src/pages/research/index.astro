---
import Base from '../../layouts/Base.astro';
import ScientificFigure from '../../components/ScientificFigure.astro';
import { sitePath } from '../../utils/paths';
import { researchThemes, papersFor } from '../../data/research';
---
<Base title="Research · Membranes, transport & molecular interactions" active="Research" description="Three research themes: membrane permeabilization, transport across permeabilized membranes, and protein–small-molecule interactions.">
  <section class="container page-intro research-intro">
    <p class="eyebrow">Research</p><h1>Membranes, transport<br/><span>and molecular interactions.</span></h1>
    <p class="lead">Three connected questions guide my work in computational biophysics.</p>
    <div class="album-nav" role="navigation" aria-label="Research themes">{researchThemes.map(theme => <a href={`#${theme.id}`}>{theme.number} / {theme.title}</a>)}</div>
  </section>
  {researchThemes.map(theme => <section class="container research-theme" id={theme.id} aria-labelledby={`${theme.id}-title`}>
    <div class="theme-heading"><p class="eyebrow">{theme.number} / Research theme</p><h2 id={`${theme.id}-title`}>{theme.title}</h2></div>
    <div class="theme-body"><div class="theme-copy"><h3>{theme.question}</h3><p>{theme.description}</p>
      {theme.ongoing && <p class="ongoing-work"><strong>Ongoing work</strong>{theme.ongoing}</p>}
      <div class="theme-links">{theme.links.map(link => <a class="text-link" href={sitePath(link.href)}>{link.label} →</a>)}</div>
    </div><ScientificFigure id={theme.visual} class="theme-science" /></div>
    {theme.id === 'transport' && <details class="transport-visuals"><summary>Explore transport simulations</summary><div class="transport-visual-grid"><ScientificFigure id="transport-near-pore" /><ScientificFigure id="transport-comsol" /></div></details>}
    <div class="theme-publications"><h3>Selected publications</h3><ul>{papersFor(theme.papers).map(p => <li><a href={`https://doi.org/${p.doi}`} target="_blank" rel="noreferrer">{p.title} <span aria-hidden="true">↗</span></a><span>{p.journal} · {p.year}</span></li>)}</ul></div>
  </section>)}
  <section class="container research-exit"><a class="button" href={sitePath('/publications/')}>Browse all publications →</a><a class="text-link" href={sitePath('/software/')}>Explore research software →</a></section>
</Base>
